/* Ayuda */
"notarizeDMG_help" = "Ayuda suplementaria de NotarizeDMG";
"help_button_tooltip" = "Cómo funciona la creación de la DMG";
"help_title" = "Rutas para crear la DMG";
"help_step1_title" = "Dos maneras de crear la DMG";
"help_step1_body" = "En el modo **Crear y notarizar**, NotarizeDMG primero crea una DMG elegante a partir de tu `.app` firmada y después firma, notariza y adjunta el ticket a la DMG. Lo hace mediante [create-dmg](https://github.com/sindresorhus/create-dmg) si está instalada y recurre a un flujo interno con AppleScript + Finder si create-dmg no está disponible.";
"help_step2_title" = "Instalar create-dmg";
"help_step2_body" = "Para tener create-dmg en tu sistema, debes seguir estos pasos:\n⎯ Instala [Homebrew](https://brew.sh)\n⎯ Instala Node 20+ → `brew install node`\n⎯ Instala create-dmg → `npm install --global create-dmg`\n⎯ Opcional → Si recibes el mensaje\n     `allow-scripts=fs-xattr,macos-alias`\n     ejecuta\n     `npm config set allow-scripts=fs-xattr,macos-alias --location=user`";
"help_step3_title" = "Ruta preferida: create-dmg";
"help_step3_body" = "⎯ create-dmg está disponible en\n     `/usr/local/bin/create-dmg` (Mac Intel)\n     `/opt/homebrew/bin/create-dmg` (Mac Silicon).\n⎯ NotarizeDMG la detecta automáticamente y la usa para crear la DMG antes de notarizarla.\n⎯ Esta ruta es rápida y no requiere permiso de Automatización para Finder.";
"help_step4_title" = "Ruta alternativa: AppleScript + Finder";
"help_step4_body" = "⎯ Si create-dmg no está instalada, NotarizeDMG usa un flujo interno de AppleScript.\n⎯ Es posible que macOS te pida permitir la Automatización de Finder la primera vez.\n⎯ La ruta alternativa también crea la DMG y luego la firma, la notariza y le adjunta el ticket automáticamente.";
"help_workflow_title" = "¿Qué ocurre internamente?";
"help_workflow_body" = "La app ejecuta tres comandos en secuencia:\n⎯ `codesign --sign \"<Identidad>\" --timestamp \"<archivo.dmg>\"`\n⎯ `xcrun notarytool submit \"<archivo.dmg>\" --apple-id … --password … --team-id … --wait`\n⎯ `xcrun stapler staple \"<archivo.dmg>\"`";

/* Ruta alternativa de creación */
