/* Aiuto */
"notarizeDMG_help" = "Guida supplementare di NotarizeDMG";
"help_button_tooltip" = "Come funziona la creazione della DMG";
"help_title" = "Percorsi di creazione della DMG";
"help_step1_title" = "Due modi per creare la DMG";
"help_step1_body" = "Nella modalità **Crea e notarizza**, NotarizeDMG crea prima una DMG elegante dalla tua `.app` firmata, poi firma, notarizza e applica il ticket alla DMG. L’app preferisce [create-dmg](https://github.com/sindresorhus/create-dmg) quando è installato e usa altrimenti un flusso interno AppleScript + Finder.";
"help_step2_title" = "Installare create-dmg";
"help_step2_body" = "Per avere create-dmg sul tuo sistema, segui questi passi:\n⎯ Installa [Homebrew](https://brew.sh)\n⎯ Installa Node 20+ → `brew install node`\n⎯ Installa create-dmg → `npm install --global create-dmg`\n⎯ Facoltativo → Se ricevi un messaggio relativo a\n     `allow-scripts=fs-xattr,macos-alias`\n     esegui\n     `npm config set allow-scripts=fs-xattr,macos-alias --location=user`";
"help_step3_title" = "Percorso preferito: create-dmg";
"help_step3_body" = "⎯ create-dmg è disponibile in\n     `/usr/local/bin/create-dmg` (Mac Intel)\n     `/opt/homebrew/bin/create-dmg` (Mac Apple Silicon).\n⎯ NotarizeDMG lo rileva automaticamente e lo usa per creare la DMG prima della notarizzazione.\n⎯ Questo percorso è rapido e non richiede il permesso di Automazione di Finder.";
"help_step4_title" = "Percorso alternativo: AppleScript + Finder";
"help_step4_body" = "⎯ Se create-dmg non è installato, NotarizeDMG usa un flusso AppleScript integrato.\n⎯ La prima volta macOS potrebbe chiederti di consentire l’Automazione di Finder.\n⎯ Anche il percorso alternativo crea la DMG e poi l’app la firma, la notarizza e applica automaticamente il ticket.";
"help_workflow_title" = "Cosa succede dietro le quinte";
"help_workflow_body" = "L'app esegue tre comandi in sequenza:\n⎯ `codesign --sign \"<Identità>\" --timestamp \"<file.dmg>\"`\n⎯ `xcrun notarytool submit \"<file.dmg>\" --apple-id … --password … --team-id … --wait`\n⎯ `xcrun stapler staple \"<file.dmg>\"`";

