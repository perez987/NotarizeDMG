/* Aide */
"notarizeDMG_help" = "Aide supplémentaire de NotarizeDMG";
"help_button_tooltip" = "Comment fonctionne la création de DMG";
"help_title" = "Méthodes de création du DMG";
"help_step1_title" = "Deux façons de créer le DMG";
"help_step1_body" = "En mode **Créer et notariser**, NotarizeDMG crée d’abord un DMG soigné à partir de votre `.app` signée, puis signe, notarise et agrafe le ticket sur le DMG. L’app privilégie [create-dmg](https://github.com/sindresorhus/create-dmg) lorsqu’il est installé et utilise sinon un flux interne AppleScript + Finder.";
"help_step2_title" = "Installer create-dmg";
"help_step2_body" = "Pour installer create-dmg sur votre système, suivez ces étapes :\n⎯ Installez [Homebrew](https://brew.sh)\n⎯ Installez Node 20+ → `brew install node`\n⎯ Installez create-dmg → `npm install --global create-dmg`\n⎯ Facultatif → Si vous recevez un message concernant\n     `allow-scripts=fs-xattr,macos-alias`\n     exécutez\n     `npm config set allow-scripts=fs-xattr,macos-alias --location=user`";
"help_step3_title" = "Méthode préférée : create-dmg";
"help_step3_body" = "⎯ create-dmg est disponible dans\n     `/usr/local/bin/create-dmg` (Mac Intel)\n     `/opt/homebrew/bin/create-dmg` (Mac Apple Silicon).\n⎯ NotarizeDMG le détecte automatiquement et l’utilise pour créer le DMG avant la notarisation.\n⎯ Cette méthode est rapide et ne nécessite pas l’autorisation d’Automatisation du Finder.";
"help_step4_title" = "Méthode de secours : AppleScript + Finder";
"help_step4_body" = "⎯ Si create-dmg n’est pas installé, NotarizeDMG utilise un flux AppleScript intégré.\n⎯ macOS peut vous demander d’autoriser l’Automatisation du Finder lors de la première utilisation.\n⎯ Cette méthode crée tout de même le DMG puis l’app le signe, le notarise et agrafe automatiquement le ticket.";
"help_workflow_title" = "Ce qui se passe en coulisses";
"help_workflow_body" = "L'app exécute trois commandes en séquence :\n⎯ `codesign --sign \"<Identité>\" --timestamp \"<fichier.dmg>\"`\n⎯ `xcrun notarytool submit \"<fichier.dmg>\" --apple-id … --password … --team-id … --wait`\n⎯ `xcrun stapler staple \"<fichier.dmg>\"`";

