/* Hilfe */
"notarizeDMG_help" = "Ergänzende Hilfe zu NotarizeDMG";
"help_button_tooltip" = "So funktioniert die DMG-Erstellung";
"help_title" = "Wege zur DMG-Erstellung";
"help_step1_title" = "Zwei Wege zum Erstellen des DMG";
"help_step1_body" = "Im Modus **DMG erstellen und notarisieren** erstellt NotarizeDMG zunächst ein ansprechendes DMG aus Ihrer signierten `.app` und signiert, notarisiert und stapelt anschließend das DMG. Wenn [create-dmg](https://github.com/sindresorhus/create-dmg) installiert ist, wird es bevorzugt verwendet; andernfalls greift die App auf einen integrierten AppleScript- und Finder-Ablauf zurück.";
"help_step2_title" = "create-dmg installieren";
"help_step2_body" = "Um create-dmg auf Ihrem System zu haben, folgen Sie diesen Schritten:\n⎯ [Homebrew](https://brew.sh) installieren\n⎯ Node 20+ installieren → `brew install node`\n⎯ create-dmg installieren → `npm install --global create-dmg`\n⎯ Optional → Wenn Sie eine Meldung über\n     `allow-scripts=fs-xattr,macos-alias`\n     erhalten, führen Sie aus\n     `npm config set allow-scripts=fs-xattr,macos-alias --location=user`";
"help_step3_title" = "Bevorzugter Weg: create-dmg";
"help_step3_body" = "⎯ create-dmg ist verfügbar unter\n     `/usr/local/bin/create-dmg` (Intel Mac)\n     `/opt/homebrew/bin/create-dmg` (Apple Silicon Mac).\n⎯ NotarizeDMG erkennt das Tool automatisch und verwendet es vor der Notarisierung zum Erstellen des DMG.\n⎯ Dieser Weg ist schnell und benötigt keine Finder-Automatisierungsberechtigung.";
"help_step4_title" = "Ausweichweg: AppleScript + Finder";
"help_step4_body" = "⎯ Wenn create-dmg nicht installiert ist, verwendet NotarizeDMG einen integrierten AppleScript-Ablauf.\n⎯ Beim ersten Mal kann macOS Sie auffordern, die Finder-Automatisierung zu erlauben.\n⎯ Auch dieser Weg erstellt das DMG und die App signiert, notarisiert und stapelt es anschließend automatisch.";
"help_workflow_title" = "Was im Hintergrund passiert";
"help_workflow_body" = "Die App führt drei Befehle der Reihe nach aus:\n⎯ `codesign --sign \"<Identität>\" --timestamp \"<Datei.dmg>\"`\n⎯ `xcrun notarytool submit \"<Datei.dmg>\" --apple-id … --password … --team-id … --wait`\n⎯ `xcrun stapler staple \"<Datei.dmg>\"`";

/* Ausweichweg */
"build_fallback_title" = "AppleScript-Ausweichweg bereit";
"build_fallback_message" = "create-dmg ist nicht installiert, daher verwendet Erstellen und Notarisieren den integrierten Finder-basierten Ausweichweg. macOS kann eine Finder-Automatisierungsberechtigung anfordern.";

