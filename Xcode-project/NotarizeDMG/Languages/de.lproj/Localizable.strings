"finder_automation_permission_message" = "NotarizeDMG benötigt die Finder-Automatisierungsberechtigung, um das DMG-Fensterlayout anzuwenden. Erlauben Sie den Finder-Zugriff bei der Aufforderung oder aktivieren Sie NotarizeDMG unter Systemeinstellungen > Datenschutz und Sicherheit > Automatisierung und versuchen Sie es erneut.";
"finder_automation_unavailable_message" = "Finder ist derzeit für die Automatisierung nicht verfügbar. Versuchen Sie es erneut, nachdem Finder vollständig gestartet ist.";
"finder_automation_failed_format" = "Die Prüfung der Finder-Automatisierungsberechtigung ist fehlgeschlagen (OSStatus %lld).";
"finder_layout_not_persisted_message" = "Finder hat das DMG-Fensterlayout nicht auf die Festplatte geschrieben. Vergewissern Sie sich, dass NotarizeDMG unter Systemeinstellungen > Datenschutz und Sicherheit > Automatisierung den Finder steuern darf, und versuchen Sie es erneut.";
