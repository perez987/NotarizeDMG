/* Help */
"notarizeDMG_help" = "NotarizeDMG Supplementary Help";
"help_button_tooltip" = "How DMG creation works";
"help_title" = "DMG creation paths";
"help_step1_title" = "Two ways to build the DMG";
"help_step1_body" = "In **Build & Notarize** mode, NotarizeDMG first creates a polished DMG from your signed `.app`, then signs, notarizes, and staples the DMG. It prefers [create-dmg](https://github.com/sindresorhus/create-dmg) when installed and falls back to a built-in AppleScript + Finder workflow when create-dmg is not available.";
"help_step2_title" = "Install create-dmg";
"help_step2_body" = "To have create-dmg on your system, follow these steps:\n⎯ Install [Homebrew](https://brew.sh)\n⎯ Install Node 20+ → `brew install node`\n⎯ Install create-dmg → `npm install --global create-dmg`\n⎯ Optional → If you get a message about\n     `allow-scripts=fs-xattr,macos-alias`\n     run\n     `npm config set allow-scripts=fs-xattr,macos-alias --location=user`";
"help_step3_title" = "Preferred path: create-dmg";
"help_step3_body" = "⎯ create-dmg is available at\n     `/usr/local/bin/create-dmg` (Intel Mac)\n     `/opt/homebrew/bin/create-dmg` (Apple Silicon Mac).\n⎯ NotarizeDMG detects it automatically and uses it to build the DMG before notarization.\n⎯ This path is fast and does not require Finder Automation permission.";
"help_step4_title" = "Fallback path: AppleScript + Finder";
"help_step4_body" = "⎯ If create-dmg is not installed, NotarizeDMG falls back to a built-in AppleScript workflow.\n⎯ macOS may ask you to allow Finder Automation the first time.\n⎯ The fallback still creates the DMG, then the app signs, notarizes, and staples it automatically.";
"help_workflow_title" = "What happens under the hood";
"help_workflow_body" = "The app runs three commands in sequence:\n⎯ `codesign --sign \"<Identity>\" --timestamp \"<file.dmg>\"`\n⎯ `xcrun notarytool submit \"<file.dmg>\" --apple-id … --password … --team-id … --wait`\n⎯ `xcrun stapler staple \"<file.dmg>\"`";

